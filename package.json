{
  "name": "goose-host-conformance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runs the MCP Apps conformance suite against Goose — a worked example of an Electron desktop host adapter on top of mcp-apps-conformance.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "server": "mcp-apps-conformance",
    "server:stdio": "mcp-apps-conformance --stdio",
    "conformance": "tsx src/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mcp-apps-conformance": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "playwright": "^1.49.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
